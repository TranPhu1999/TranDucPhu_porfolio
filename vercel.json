{
  "redirects": [
    {
      "source": "/",
      "destination": "/me/",
      "permanent": false
    },
    {
      "source": "/me",
      "destination": "/me/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/me/",
      "destination": "/index.html"
    },
    {
      "source": "/me/:path*",
      "destination": "/:path*"
    }
  ],
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true
}